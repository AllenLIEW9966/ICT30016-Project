{
  "name": "secure-coding-assistant",
  "displayName": "Secure Coding Assistant",
  "description": "Real-time security scanning and AI-assisted fixing for Python, JavaScript, and common dependency manifests.",
  "version": "0.1.60",
  "publisher": "your-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllenLIEW9966/ICT30016-Project.git"
  },
  "icon": "images/codeshield-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "secureCoding.scanCurrentFile",
        "title": "Secure Coding: Scan Current File"
      },
      {
        "command": "secureCoding.scanWorkspace",
        "title": "Secure Coding: Scan Workspace Security Findings"
      },
      {
        "command": "secureCoding.fixWithAI",
        "title": "Secure Coding: Fix with AI"
      },
      {
        "command": "secureCoding.showSecurityScore",
        "title": "Secure Coding: Show Current File Findings"
      },
      {
        "command": "secureCoding.showBackendLog",
        "title": "Secure Coding: Show Backend Log"
      },
      {
        "command": "secureCoding.installLocalAI",
        "title": "Secure Coding: Configure AI Provider"
      },
      {
        "command": "secureCoding.fixAllFile",
        "title": "Secure Coding: Fix All Vulnerabilities in File"
      }
    ],
    "configuration": {
      "title": "Secure Coding Assistant",
      "properties": {
        "secureCoding.osvAdvisories": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Look up dependency advisories in trusted workspaces. Sends package names, ecosystems and exact versions to OSV.dev via the backend."
        },
        "secureCoding.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Backend API URL"
        },
        "secureCoding.aiApiBase": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "scope": "machine",
          "description": "Local Ollama API base URL"
        },
        "secureCoding.aiProvider": {
          "type": "string",
          "enum": [
            "ollama",
            "groq",
            "gemini",
            "openrouter",
            "custom"
          ],
          "default": "ollama",
          "scope": "machine",
          "description": "AI provider. Cloud providers receive code context when you request a fix."
        },
        "secureCoding.cloudApiBase": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Base URL for a custom OpenAI-compatible cloud API"
        },
        "secureCoding.aiModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b-instruct",
          "scope": "machine",
          "description": "Model ID for the selected AI provider"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.3.0"
  }
}
