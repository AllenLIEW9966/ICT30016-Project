{
  "name": "secure-coding-assistant",
  "displayName": "Secure Coding Assistant",
  "description": "Real-time AI-powered secure coding assistant for Python and JavaScript.",
  "version": "0.1.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "secureCoding.scanCurrentFile",
        "title": "Secure Coding: Scan Current File"
      },
      {
        "command": "secureCoding.fixWithAI",
        "title": "Secure Coding: Fix with AI"
      },
      {
        "command": "secureCoding.showSecurityScore",
        "title": "Secure Coding: Show Security Score"
      },
      {
        "command": "secureCoding.showBackendLog",
        "title": "Secure Coding: Show Backend Log"
      },
      {
        "command": "secureCoding.installLocalAI",
        "title": "Secure Coding: Install Local AI (Ollama)"
      },
      {
        "command": "secureCoding.fixAllFile",
        "title": "Secure Coding: Fix All Vulnerabilities in File"
      }
    ],
    "configuration": {
      "title": "Secure Coding Assistant",
      "properties": {
        "secureCoding.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Backend API URL"
        },
        "secureCoding.aiApiBase": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Local Ollama API base URL (100% on-device, NFR-02)"
        },
        "secureCoding.aiApiKey": {
          "type": "string",
          "default": "ollama",
          "description": "API key for AI model"
        },
        "secureCoding.aiProvider": {
          "type": "string",
          "enum": ["ollama", "cloud"],
          "default": "ollama",
          "description": "AI provider: local Ollama (private) or cloud API"
        },
        "secureCoding.cloudApiBase": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Cloud AI API base URL (OpenAI, Anthropic, or compatible)"
        },
        "secureCoding.aiModel": {
          "type": "string",
          "enum": ["qwen2.5-coder:1.5b-instruct", "codellama:7b-instruct", "gpt-4o-mini", "gpt-3.5-turbo", "claude-3-haiku-20240307"],
          "enumDescriptions": [
            "Small, fast local model (~1 GB) — recommended default",
            "Larger local model (~4 GB) — needs more RAM",
            "OpenAI GPT-4o Mini (cloud)",
            "OpenAI GPT-3.5 Turbo (cloud)",
            "Anthropic Claude 3 Haiku (cloud)"
          ],
          "default": "qwen2.5-coder:1.5b-instruct",
          "description": "AI model for suggestions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.3.0"
  }
}
